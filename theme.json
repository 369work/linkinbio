{
    "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
    "version": 3,
    "settings": {
        "layout": {
            "contentSize": "480px",
            "wideSize": "480px"
        },
        "useRootPaddingAwareAlignments": true,
        "appearanceTools": true,
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "defaultDuotone": false,
            "palette": [
                {
                    "slug": "foreground",
                    "color": "#1a1a1a",
                    "name": "Foreground"
                },
                {
                    "slug": "background",
                    "color": "#f5f5f5",
                    "name": "Background"
                },
                {
                    "slug": "surface",
                    "color": "#ffffff",
                    "name": "Surface"
                },
                {
                    "slug": "muted",
                    "color": "#6b7280",
                    "name": "Muted"
                },
                {
                    "slug": "accent",
                    "color": "#3b82f6",
                    "name": "Accent"
                },
                {
                    "slug": "border",
                    "color": "rgba(0,0,0,0.06)",
                    "name": "Border"
                },
                {
                    "slug": "white",
                    "color": "#ffffff",
                    "name": "White"
                },
                {
                    "slug": "black",
                    "color": "#000000",
                    "name": "Black"
                },
                {
                    "slug": "bio-bg",
                    "color": "#0f172a",
                    "name": "Bio Background"
                },
                {
                    "slug": "bio-card",
                    "color": "rgba(255,255,255,0.12)",
                    "name": "Bio Glass Card"
                },
                {
                    "slug": "bio-button",
                    "color": "#ffffff",
                    "name": "Bio Button"
                }
            ]
        },
        "spacing": {
            "padding": true,
            "margin": true,
            "blockGap": true,
            "units": [
                "px",
                "em",
                "rem",
                "%",
                "vh",
                "vw"
            ],
            "defaultSpacingSizes": false,
            "spacingSizes": [
                {
                    "name": "2X-Small",
                    "size": "0.25rem",
                    "slug": "10"
                },
                {
                    "name": "X-Small",
                    "size": "0.5rem",
                    "slug": "20"
                },
                {
                    "name": "Small",
                    "size": "1rem",
                    "slug": "30"
                },
                {
                    "name": "Medium",
                    "size": "1.5rem",
                    "slug": "40"
                },
                {
                    "name": "Large",
                    "size": "2rem",
                    "slug": "50"
                },
                {
                    "name": "X-Large",
                    "size": "3rem",
                    "slug": "60"
                }
            ]
        },
        "typography": {
            "defaultFontSizes": false,
            "dropCap": false,
            "fontFamilies": [
                {
                    "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans JP', sans-serif",
                    "name": "System Sans",
                    "slug": "system-sans"
                }
            ],
            "fontSizes": [
                {
                    "name": "Small",
                    "size": "0.75rem",
                    "slug": "sm"
                },
                {
                    "name": "Base",
                    "size": "0.875rem",
                    "slug": "base"
                },
                {
                    "name": "Medium",
                    "size": "1rem",
                    "slug": "md"
                },
                {
                    "name": "Large",
                    "size": "1.25rem",
                    "slug": "lg"
                },
                {
                    "name": "Extra Large",
                    "size": "1.5rem",
                    "slug": "xl"
                },
                {
                    "name": "2X-Large",
                    "size": "2rem",
                    "slug": "2xl"
                }
            ],
            "lineHeight": true
        },
        "border": {
            "radius": true
        },
        "styles": {
            "color": {
                "text": "var(--wp--preset--color--foreground)",
                "background": "var(--wp--preset--color--background)"
            },
            "typography": {
                "fontFamily": "var(--wp--preset--font-family--system-sans)",
                "fontSize": "var(--wp--preset--font-size--base)",
                "fontWeight": "400",
                "lineHeight": "1.7"
            },
            "spacing": {
                "blockGap": "0",
                "padding": {
                    "top": "0",
                    "right": "0",
                    "bottom": "0",
                    "left": "0"
                },
                "margin": {
                    "top": "0",
                    "right": "0",
                    "bottom": "0",
                    "left": "0"
                }
            },
            "elements": {
                "link": {
                    "color": {
                        "text": "inherit"
                    },
                    "typography": {
                        "textDecoration": "none"
                    },
                    ":hover": {
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                }
            }
        }
    },
    "styles": {
        "color": {
            "text": "var(--wp--preset--color--foreground)",
            "background": "var(--wp--preset--color--background)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system-sans)",
            "fontSize": "var(--wp--preset--font-size--base)",
            "fontWeight": "400",
            "lineHeight": "1.7"
        },
        "spacing": {
            "blockGap": "0",
            "padding": {
                "top": "0",
                "right": "0",
                "bottom": "0",
                "left": "0"
            },
            "margin": {
                "top": "0",
                "right": "0",
                "bottom": "0",
                "left": "0"
            }
        },
        "elements": {
            "link": {
                "color": {
                    "text": "inherit"
                },
                "typography": {
                    "textDecoration": "none"
                },
                ":hover": {
                    "typography": {
                        "textDecoration": "none"
                    }
                }
            }
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header",
            "title": "Header"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Footer"
        }
    ]
}