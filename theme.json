{
    "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
    "version": 3,
    "settings": {
        "layout": {
            "contentSize": "480px",
            "wideSize": "480px"
        },
        "useRootPaddingAwareAlignments": true,
        "appearanceTools": true,
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "defaultDuotone": false,
            "palette": [
                {
                    "slug": "foreground",
                    "color": "#1a1a1a",
                    "name": "Foreground"
                },
                {
                    "slug": "background",
                    "color": "#f5f5f5",
                    "name": "Background"
                },
                {
                    "slug": "surface",
                    "color": "#ffffff",
                    "name": "Surface"
                },
                {
                    "slug": "muted",
                    "color": "#5b6370",
                    "name": "Muted"
                },
                {
                    "slug": "accent",
                    "color": "#2563eb",
                    "name": "Accent"
                },
                {
                    "slug": "border",
                    "color": "rgba(0,0,0,0.06)",
                    "name": "Border"
                },
                {
                    "slug": "white",
                    "color": "#ffffff",
                    "name": "White"
                },
                {
                    "slug": "black",
                    "color": "#000000",
                    "name": "Black"
                }
            ]
        },
        "custom": {
            "lib": {
                "radius": "16px",
                "light": {
                    "bg": "#f5f5f5",
                    "pageBackground": "#f5f5f5",
                    "surface": "#ffffff",
                    "fg": "#1a1a1a",
                    "fgSoft": "#4b5563",
                    "muted": "#5b6370",
                    "accent": "#2563eb",
                    "accentHover": "#1d4ed8",
                    "onAccent": "#ffffff",
                    "border": "rgba(0, 0, 0, 0.06)",
                    "borderStrong": "rgba(0, 0, 0, 0.10)",
                    "shadow": "0 1px 3px rgba(0, 0, 0, 0.04)",
                    "rowBackground": "transparent",
                    "rowHover": "#f5f5f5",
                    "cardBlur": "none"
                },
                "dark": {
                    "bg": "#111111",
                    "pageBackground": "#111111",
                    "surface": "#1e1e1e",
                    "fg": "#f0f0f0",
                    "fgSoft": "#d1d5db",
                    "muted": "#9ca3af",
                    "accent": "#60a5fa",
                    "accentHover": "#93bbfd",
                    "onAccent": "#0b1220",
                    "border": "rgba(255, 255, 255, 0.08)",
                    "borderStrong": "rgba(255, 255, 255, 0.12)",
                    "shadow": "0 1px 3px rgba(0, 0, 0, 0.3)",
                    "rowBackground": "transparent",
                    "rowHover": "#111111",
                    "cardBlur": "none"
                }
            }
        },
        "spacing": {
            "padding": true,
            "margin": true,
            "blockGap": true,
            "units": [
                "px",
                "em",
                "rem",
                "%",
                "vh",
                "vw"
            ],
            "defaultSpacingSizes": false,
            "spacingSizes": [
                {
                    "name": "2X-Small",
                    "size": "0.25rem",
                    "slug": "10"
                },
                {
                    "name": "X-Small",
                    "size": "0.5rem",
                    "slug": "20"
                },
                {
                    "name": "Small",
                    "size": "1rem",
                    "slug": "30"
                },
                {
                    "name": "Medium",
                    "size": "1.5rem",
                    "slug": "40"
                },
                {
                    "name": "Large",
                    "size": "2rem",
                    "slug": "50"
                },
                {
                    "name": "X-Large",
                    "size": "3rem",
                    "slug": "60"
                }
            ]
        },
        "typography": {
            "defaultFontSizes": false,
            "dropCap": false,
            "fontFamilies": [
                {
                    "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans JP', sans-serif",
                    "name": "System Sans",
                    "slug": "system-sans"
                }
            ],
            "fontSizes": [
                {
                    "name": "Small",
                    "size": "0.75rem",
                    "slug": "sm"
                },
                {
                    "name": "Base",
                    "size": "0.875rem",
                    "slug": "base"
                },
                {
                    "name": "Medium",
                    "size": "1rem",
                    "slug": "md"
                },
                {
                    "name": "Large",
                    "size": "1.25rem",
                    "slug": "lg"
                },
                {
                    "name": "Extra Large",
                    "size": "1.5rem",
                    "slug": "xl"
                },
                {
                    "name": "2X-Large",
                    "size": "2rem",
                    "slug": "xxl"
                }
            ],
            "lineHeight": true
        },
        "border": {
            "radius": true
        }
    },
    "styles": {
        "color": {
            "text": "var(--wp--preset--color--foreground)",
            "background": "var(--wp--preset--color--background)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system-sans)",
            "fontSize": "var(--wp--preset--font-size--base)",
            "fontWeight": "400",
            "lineHeight": "1.7"
        },
        "spacing": {
            "blockGap": "0",
            "padding": {
                "top": "0",
                "right": "0",
                "bottom": "0",
                "left": "0"
            },
            "margin": {
                "top": "0",
                "right": "0",
                "bottom": "0",
                "left": "0"
            }
        },
        "elements": {
            "link": {
                "color": {
                    "text": "inherit"
                },
                "typography": {
                    "textDecoration": "none"
                },
                ":hover": {
                    "typography": {
                        "textDecoration": "none"
                    }
                }
            }
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header",
            "title": "Header"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Footer"
        }
    ]
}
