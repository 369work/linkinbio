{
    "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
    "version": 3,
    "title": "Glass (Light)",
    "settings": {
        "color": {
            "palette": [
                {
                    "slug": "foreground",
                    "color": "#0f172a",
                    "name": "Foreground"
                },
                {
                    "slug": "background",
                    "color": "#e0e7ff",
                    "name": "Background"
                },
                {
                    "slug": "surface",
                    "color": "rgba(255,255,255,0.55)",
                    "name": "Surface"
                },
                {
                    "slug": "muted",
                    "color": "#475569",
                    "name": "Muted"
                },
                {
                    "slug": "accent",
                    "color": "#4f46e5",
                    "name": "Accent"
                },
                {
                    "slug": "border",
                    "color": "rgba(255,255,255,0.6)",
                    "name": "Border"
                },
                {
                    "slug": "white",
                    "color": "#ffffff",
                    "name": "White"
                },
                {
                    "slug": "black",
                    "color": "#000000",
                    "name": "Black"
                }
            ]
        },
        "custom": {
            "lib": {
                "radius": "24px",
                "light": {
                    "bg": "#e0e7ff",
                    "pageBackground": "linear-gradient(160deg, #e0e7ff 0%, #f5d0fe 50%, #cffafe 100%) fixed",
                    "surface": "rgba(255, 255, 255, 0.55)",
                    "fg": "#0f172a",
                    "fgSoft": "#334155",
                    "muted": "#475569",
                    "accent": "#4f46e5",
                    "accentHover": "#4338ca",
                    "onAccent": "#ffffff",
                    "border": "rgba(255, 255, 255, 0.7)",
                    "borderStrong": "rgba(255, 255, 255, 0.8)",
                    "shadow": "0 8px 32px rgba(31, 38, 135, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.6)",
                    "rowBackground": "rgba(255, 255, 255, 0.4)",
                    "rowHover": "rgba(255, 255, 255, 0.7)",
                    "cardBlur": "blur(18px) saturate(160%)"
                },
                "dark": {
                    "bg": "#0f172a",
                    "pageBackground": "linear-gradient(160deg, #0f172a 0%, #3b0764 50%, #083344 100%) fixed",
                    "surface": "rgba(15, 23, 42, 0.55)",
                    "fg": "#f1f5f9",
                    "fgSoft": "#cbd5e1",
                    "muted": "#a5b4cf",
                    "accent": "#a5b4fc",
                    "accentHover": "#c7d2fe",
                    "onAccent": "#0f172a",
                    "border": "rgba(255, 255, 255, 0.12)",
                    "borderStrong": "rgba(255, 255, 255, 0.18)",
                    "shadow": "0 8px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.06)",
                    "rowBackground": "rgba(255, 255, 255, 0.04)",
                    "rowHover": "rgba(255, 255, 255, 0.10)",
                    "cardBlur": "blur(18px) saturate(160%)"
                }
            }
        }
    },
    "styles": {
        "color": {
            "background": "#e0e7ff",
            "text": "#0f172a"
        },
        "blocks": {
            "core/group": {
                "border": {
                    "radius": "24px"
                }
            },
            "core/button": {
                "border": {
                    "radius": "999px"
                }
            }
        }
    }
}
